
<!-- ログイン画面 -->

<% layout('layouts/boilerplate') %>

<div class="container">
    <h1 class="text-center">ログイン</h1>
    <div class="row mt-3">
        <div class="col-md-6 offset-md-3 col-xl-4 offset-xl-4">
            <form action="/login" method="post" class="validated-form mb-5" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">ユーザー名</label>
                    <input type="text" id="username" name="username" class="form-control" required value="aaa">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">パスワード</label>
                    <input type="password" id="password" name="password" class="form-control" required value="aaaaaaaa">
                </div>
                <button class="btn btn-primary">ログイン</button>
            </form>
            <p>会員登録がお済でない方は<span><a href="/register">こちら</a></span>から会員登録</p>
            <a href="/register" class="btn btn-dark">ユーザー新規登録</a>
        </div>
    </div>
</div>