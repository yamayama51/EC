
<!-- 商品編集画面 -->

<% layout('layouts/boilerplate') %>

<h1>商品編集</h1>

<form action="/products/<%= product._id %>?_method=PUT" method="post">
    <div class="mb-3">
        <label for="name">商品名：</label>
        <input type="text" id="name" name="product[name]" value="<%= product.name %>" required>
    </div>
    <div class="mb-3">
        <label for="price">価格：</label>
        <input type="text" id="price" name="product[price]" value="<%= product.price %>" required>
    </div>
    <div class="mb-3">
        <label for="description">商品説明：</label>
        <textarea id="description" name="product[description]" required><%= product.description %></textarea>
    </div>
    <div class="mb-3">
        <label for="image">商品画像：</label>
        <input type="text" id="image" name="product[image]" value="<%= product.image %>" required>
    </div>
    <div class="mb-3">
        <label for="category">カテゴリー：</label>
        <input type="text" id="category" name="product[category]" value="<%= product.category %>" required>
    </div>
    <div class="mb-3">
        <label for="stock">在庫数：</label>
        <input type="text" id="stock" name="product[stock]" value="<%= product.stock %>" required>
    </div>
    <button>更新</button>
</form>