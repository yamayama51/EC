
<%# 商品一覧画面 %>

<% layout('layouts/boilerplate') %>

<div class="row">
<% for(product of products) { %>
    <div class="col-6 col-sm-6 col-md-4 col-lg-3 mb-4">
        <div class="card shadow-sm border-0 position-relative product-card">
            <a href="/products/<%= product._id %>" class="text-muted text-decoration-none">
                <%# 画像部分 %>
                <% if (product.images && product.images.length) { %>
                    <div class="ratio ratio-1x1 overflow-hidden">
                        <img src="<%= product.images[0].url %>" class="card-img-top object-fit-cover" alt="product-img">
                    </div>
                <% } else { %>
                    <div class="ratio ratio-1x1 overflow-hidden">
                        <img src="/images/no-image.png" class="card-img-top object-fit-cover" alt="no-img">
                    </div>
                <% } %>

                <%# 商品情報 %>
                <div class="card-body position-relative">
                    <%# 在庫切れの場合のバッジ %>
                    <% if (product.stock <= 0) { %>
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2 p-2">
                            SOLD OUT
                        </span>
                    <% } %>
                    <p class="text-secondary small mb-1"><%= product.category %></p>
                    <p class="card-title h5 fw-bold mb-1 text-dark"><%= product.name %></p>
                    <p class="card-text fw-bold text-dark">\ <%= product.price.toLocaleString() %></p>
                </div>
            </a>
        </div>
    </div>
<% } %>
</div>
