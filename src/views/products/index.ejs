
<%# 商品一覧画面 %>

<% layout('layouts/boilerplate') %>

<div class="row faze-container mb-3">

    <h1 class="text-center fw-normal my-5">FAZE.</h1>

    <div class="mb-5">
        <% if (categoryName) { %>
            <h5 class="mb-5 fw-normal"><%= categoryName.toUpperCase() %></h5>
        <% } else { %>
            <h5 class="mb-5 fw-normal">ALL ITEM</h5>
        <% } %>
        <hr>
    </div>

    <%# 商品が登録されていない場合 %>
    <% if (products.length === 0) { %>
        <div class="col-md-4">
            <p class="h4 text-muted fw-bold mb-5">現在販売中のアイテムがありません</p>
            <a href="/" class="btn btn-dark px-5 py-3">ホームへ</a>
        </div>
    <% } %>

    <% for(product of products) { %>
        <div class="col-6 col-md-3 mb-5">
            <div class="h-100 product-card">
                <a href="/products/<%= product._id %>" class="text-muted text-decoration-none">
                    <%# 画像部分 %>
                    <% if (product.images && product.images.length) { %>
                        <div class="ratio ratio-1x1 overflow-hidden">
                            <img src="<%= product.images[0].url %>" class="card-img-top object-fit-cover" alt="product-img">
                        </div>
                    <% } else { %>
                        <div class="ratio ratio-1x1 overflow-hidden">
                            <img src="/images/no-image.png" class="card-img-top object-fit-cover" alt="no-img">
                        </div>
                    <% } %>

                    <%# 商品情報 %>
                    <div class="card-body product-card-body text-center">
                        <p class="card-title text-dark mb-1"><%= product.name %></p>
                        <p class="card-text text-dark fw-light">&yen; <%= product.price.toLocaleString() %></p>
                    </div>
                </a>
            </div>
        </div>
    <% } %>

    <%# ページングナビ %>
    <%- include('../partials/pagination') %>
</div>