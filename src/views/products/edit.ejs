
<%# 商品詳細画面 %>

<% layout('layouts/boilerplate') %>

<div class="row">
    <h1 class="text-center">商品編集</h1>
    <div class="offset-3 col-md-6">
        <form action="/products/<%= product._id %>?_method=PUT" method="post" class="validated-form" novalidate enctype="multipart/form-data">
            <div class="mb-3">
                <label for="name" class="form-label">商品名：</label>
                <input type="text" id="name" name="product[name]" class="form-control" value="<%= product.name %>" required>
            </div>
            <div class="mb-3">
                <label for="price" class="form-label">価格：</label>
                <input type="text" id="price" name="product[price]" class="form-control" value="<%= product.price %>" required>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">商品説明：</label>
                <textarea id="description" name="product[description]" class="form-control" required><%= product.description %></textarea>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">商品画像のアップロード：</label>
                <input type="file" id="image" name="product[images]" class="form-control" multiple>
            </div>
            <div class="mb-3">
                <% product.images.forEach((img, i) => { %>
                    <img src="<%= img.thumbnail %>" alt="">
                    <input type="checkbox" id="image-<%= i %>" name="deleteImages[]" value="<%= img.filename %>">
                    <label for="image-<%= i %>">削除する</label>
                <% }) %>
            </div>
            <div class="mb-3">
                <label for="category" class="form-label">カテゴリー：</label>
                <select id="category" name="product[category]" class="form-select" required>
                    <% Object.values(categories).forEach(category => { %>
                    <option value="<%= category %>" <%= product.category === category ? 'selected' : '' %>>
                        <%= category %>
                    </option>
                    <% }) %>
                </select>
            </div>
            <div class="mb-3">
                <label for="stock" class="form-label">在庫数：</label>
                <input type="text" id="stock" name="product[stock]" class="form-control" value="<%= product.stock %>" required>
            </div>
            <button class="btn btn-success">更新</button>
            <a href="/products/<%= product._id %>" class="btn btn-secondary">商品詳細へ</a>
        </form>
    </div>
</div>