
<%# 商品登録画面 %>

<% layout('layouts/boilerplate') %>

<div class="row">
    <h1 class="text-center">商品登録</h1>
    <div class="offset-3 col-md-6">
        <form action="/products" method="post" class="validated-form" novalidate enctype="multipart/form-data">
            <div class="mb-3">
                <label for="name" class="form-label">商品名：</label>
                <input type="text" id="name" name="product[name]" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="price">価格：</label>
                <input type="text" id="price" name="product[price]" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="description">商品説明：</label>
                <textarea id="description" name="product[description]" class="form-control" required></textarea>
            </div>
            <div class="mb-3">
                <label for="image">商品画像のアップロード：</label>
                <input type="file" id="image" name="product[images]" class="form-control" multiple>
            </div>
            <div class="mb-3">
                <label for="category">カテゴリー：</label>
                <select id="category" name="product[category]" class="form-select mb-3" required>
                    <% Object.values(categories).forEach(category => { %>
                    <option value="<%= category %>"><%= category %></option>
                    <% }) %>
                </select>
            </div>
            <div class="mb-3">
                <label for="stock">在庫数：</label>
                <input type="text" id="stock" name="product[stock]" class="form-control" required>
            </div>
            <button class="btn btn-primary">登録</button>
            <a href="/products" class="btn btn-secondary">商品一覧へ</a>
        </form>
    </div>
</div>