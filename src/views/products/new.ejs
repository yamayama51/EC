
<%# 商品登録画面 %>

<% layout('layouts/boilerplate') %>

<div class="row">
    <div class="card offset-3 col-md-6 p-5 rounded-4 shadow-sm border border-light">

        <h1 class="text-center mb-3 h3 fw-bold ">商品登録</h1>
        <p class="text-secondary small text-center mb-4">商品情報を入力してください</p>

        <form action="/products" method="post" class="validated-form" novalidate enctype="multipart/form-data">

            <div class="mb-5">
                <%# 商品名 %>
                <div class="form-floating mb-3">
                    <input type="text" id="floatingName" name="product[name]" class="form-control" placeholder="商品名" required>
                    <label for="floatingName" class="form-label text-muted">商品名</label>
                </div>

                <%# 価格 %>
                <div class="form-floating mb-3">
                    <input type="text" id="floatingPrice" name="product[price]" class="form-control" placeholder="価格" required>
                    <label for="floatingPrice" class="form-label text-muted">価格</label>
                </div>

                <%# 商品説明 %>
                <div class="form-floating mb-3">
                    <textarea id="floatingDescription" name="product[description]" class="form-control form-control-textarea" placeholder="商品説明" required></textarea>
                    <label for="floatingDescription" class="form-label text-muted">商品説明</label>
                </div>

                <%# 画像 %>
                <div class="mb-3">
                    <label for="image" class="form-label small fw-bold text-muted ms-1">商品画像のアップロード</label>
                    <input type="file" id="image" name="product[images]" class="form-control form-control-lg fs-6">
                </div>

                <%# カテゴリー %>
                <div class="form-floating mb-3">
                    <select id="category" name="product[category]" class="form-select mb-3" required>
                        <% Object.values(categories).forEach(category => { %>
                        <option value="<%= category %>"><%= category %></option>
                        <% }) %>
                    </select>
                    <label for="category" class="form-label text-muted">カテゴリー</label>
                </div>

                <%# 在庫数 %>
                <div class="form-floating mb-3">
                    <input type="text" id="floatingStock" name="product[stock]" class="form-control" placeholder="在庫数" required>
                    <label for="floatingStock" class="form-label text-muted">在庫数</label>
                </div>
            </div>

            <%# 操作系 %>
            <div class="d-flex justify-content-end align-items-center gap-2">
                <a href="/products" class="btn btn-link text-decoration-none text-muted me-2">商品一覧へ戻る</a>
                <button class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm">商品を登録する</button>
            </div>
        </form>
    </div>
</div>