
<!-- 商品詳細画面 -->

<% layout('layouts/boilerplate') %>

<!-- 管理者権限がある場合 -->
<% if (currentUser && currentUser.isAdmin) { %>
<div class="mb-3">
    <a href="/products/<%= product._id %>/edit" class="btn btn-success">編集</a>
    <form action="/products/<%= product._id %>?_method=DELETE" method="post" class="d-inline">
        <button class="btn btn-danger">削除</button>
    </form>
</div>
<% } %>

<h1>商品詳細</h1>

<div class="mb-3">
    <div id="productCarousel" class="carousel slide">
        <div class="carousel-indicators">
            <% product.images.forEach((img, i) => { %>
            <button
                type="button" 
                data-bs-target="#productCarousel" 
                data-bs-slide-to="<%= i %>" 
                class="<%= i === 0 ? 'active' : '' %>" 
                aria-current="<%= i === 0 ? 'true' : 'false' %>" 
                aria-label="Slide 1">
            </button>
            <% }) %>
        </div>
        <div class="carousel-inner">
            <% if (product.images && product.images.length) { %>
                <% product.images.forEach((img, i) => { %>
                    <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                        <img src="<%= img.url %>" class="d-block w-100" alt="...">
                    </div>
                <% }) %>
            <% } else { %>
                <img src="/images/no-image.png" alt="">
            <% } %>
        </div>

        <% if (product.images.length > 1) { %>
        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
        <% } %>
    </div>
    <p>
        <% if (product.stock <= 10) { %>
        残り在庫数：<%= product.stock %>点
        <% } %>
    </p>
    <p>
        商品名：<%= product.name %>
    </p>
    <p>
        \ <%= product.price.toLocaleString() %>
    </p>
    <p>
        商品説明：<%= product.description %>
    </p>
</div>

<form action="/cart" method="post" class="mb-3">
    <input type="hidden" name="productId" value="<%= product._id %>">

    <label for="quantity">数量：</label>
    <select name="quantity" id="quantity">
        <% for (let i = 1; i <= 10; i++) { %>
        <option value="<%= i %>"><%= i %></option>
        <% } %>
    </select>
    <button class="btn btn-primary">カートに入れる</button>
    <a href="/products" class="btn btn-secondary">商品一覧に戻る</a>
</form>