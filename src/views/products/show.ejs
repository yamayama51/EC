
<%# 商品詳細画面 %>

<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/stars.css">

<div class="mb-3">
    <div class="row faze-container g-lg-5">

        <%# 商品編集ボタン：ログイン済みかつ管理者ユーザの時のみ表示 %>
        <% if (currentUser && currentUser.isAdmin) { %>
            <div class="mb-3">
                <a href="/admin/products/<%= product._id %>/edit" class="btn btn-sm btn-primary mx-3">編集</a>
                <button type="submit" class="btn btn-sm btn-danger" 
                        data-bs-toggle="modal" 
                        data-bs-target="#deleteModal" 
                        data-id="<%= product._id %>" 
                        data-name="<%= product.name %>"
                        data-url="/admin/products/<%= product._id %>?_method=DELETE"> 
                    削除
                </button>
            </div>
        <% } %>

        <%# 右半分 %>
        <div class="col-lg-6 mb-5">

            <%# 商品画像表示：カルーセルあり %>
            <div id="productCarousel" class="carousel slide">
                <div class="carousel-indicators">
                    <% product.images.forEach((img, i) => { %>
                    <button
                        type="button" 
                        data-bs-target="#productCarousel" 
                        data-bs-slide-to="<%= i %>" 
                        class="<%= i === 0 ? 'active' : '' %>" 
                        aria-current="<%= i === 0 ? 'true' : 'false' %>" 
                        aria-label="Slide 1">
                    </button>
                    <% }) %>
                </div>
                <div class="carousel-inner shadow-sm">
                    <% if (product.images && product.images.length) { %>
                        <% product.images.forEach((img, i) => { %>
                            <div class="ratio ratio-1x1 overflow-hidden rounded-3 carousel-item <%= i === 0 ? 'active' : '' %>">
                                <img src="<%= img.url %>" class="card-img-top object-fit-cover" alt="product-img">
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="ratio ratio-1x1 overflow-hidden rounded-3 carousel-item active">
                            <img src="/images/no-image.png" class="card-img-top object-fit-cover" alt="no-img">
                        </div>
                    <% } %>
                </div>

                <% if (product.images.length > 1) { %>
                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
                <% } %>
            </div>
        </div>

        <%# 左半分 %>
        <div class="col-lg-6 position-relative">

            <%# 商品メイン情報 %>
            <div class="mt-2">
                <p class="h6 fw-normal mb-2"><%= product.name %></p>
                <p class="h5 fw-bold text-muted mb-1">&yen; <%= product.price.toLocaleString() %> <span class="faze-small fw-normal">税込み</span></p>
            </div>

            <hr class="my-5 opacity-10">

            <%# 操作ボタンカード %>
            <div class="card border-0 shadow-sm bg-white p-4 rounded-3">
                <form action="/cart" method="post" class="mb-3">
                    <input type="hidden" name="cart[productId]" value="<%= product._id %>">

                    <%# 数量 %>
                    <div class="row mb-5 align-items-center">
                        <label for="quantity" class="col-3 fw-bold">数量</label>
                        <div class="col-9">
                            <select name="cart[quantity]" id="quantity" class="form-select border-0 bg-light shadow-sm">
                                <% for (let i = 1; i <= 10; i++) { %>
                                <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <%# サイズ %>
                    <div class="mb-5">
                        <input type="hidden" name="cart[variantId]" value="<%= selectedVariant._id %>">
                        <% for (variant of variants) { %>
                            <a href="/products/<%= product._id %>?size=<%= variant.size %>" 
                                class="faze-size-btn btn btn-outline-secondary mx-1 <%= selectedVariant && selectedVariant._id.equals(variant._id) ? 'active' : '' %>">
                                <%= variant.size.toUpperCase() %>
                            </a>
                        <% } %>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit"
                            class="btn btn-dark py-3 fw-bold mb-3" 
                            data-original-text="カートに入れる">
                            カートに入れる
                        </button>
                        <a href="/products" class="btn text-muted">商品一覧に戻る</a>
                    </div>
                </form>
            </div>

            <hr class="my-5 opacity-10">

            <%# 商品補足情報 %>
            <div class="mb-5 px-3 bg-light">
                <p class="small lh-lg fw-normal product-description"><%= product.description %></p>
            </div>

            <hr class="my-5 opacity-10">

            <%# レビュー投稿欄 %>
            <%# この商品の購入歴がある人かつレビュー未投稿者のみに表示 %>
            <% if (currentUser && canWriteReview) { %>
            <div class="row my-5 justify-content-center">
                <div class="col-md-10">
                    <h3 class="h4 fw-bold mb-4">この商品のレビューを投稿する</h3>
                    <form action="/products/<%= product._id %>/reviews" method="POST" class="validated-form" novalidate>

                        <%# レビューレーティング %>
                        <div class="">
                            <label class="form-label fw-bold small text-muted" for="rating">評価 (5段階)</label>
                            <fieldset class="starability-basic">
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" checked/>
                                <label for="first-rate1" title="1">評価：1</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="2">評価：2</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="3">評価：3</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="4">評価：4</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="5">評価：5</label>
                            </fieldset>
                        </div>

                        <%# レビュータイトル %>
                        <div class="mb-3">
                            <label for="title" class="form-label fw-bold small text-muted">タイトル</label>
                            <input type="text" name="review[title]" id="title" class="form-control" maxlength="30" placeholder="レビュータイトルを記入してください" required>
                        </div>

                        <%# レビュー本文 %>
                        <div class="mb-3">
                            <label for="body" class="form-label fw-bold small text-muted">レビュー本文</label>
                            <textarea 
                                class="form-control" 
                                name="review[body]" 
                                id="body"
                                rows="5" 
                                placeholder="商品の感想や良かった点、気になった点などを自由に記入してください" 
                                required></textarea>
                        </div>
                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-dark" data-original-text="レビューを投稿する">レビューを投稿する</button>
                        </div>
                    </form>
                </div>
            </div>

            <hr class="my-4 opacity-10">
            <% } %>

            <%# レビュー一覧 %>
            <div class="row my-5 justify-content-center">
                <div class="col-md-10">
                    <h3 class="h4 fw-bold mb-4">レビュー（<%= product.reviews.length %>件）</h3>
                    
                    <% for (let review of product.reviews) { %>
                        <div class="mb-4 p-3 border-bottom d-flex justify-content-between">
                            <%# レビューの本文 %>
                            <div>
                                <p class="text-muted fw-bold mb-0 mt-2">投稿者 : <%= review.author.username %></p>
                                <div class="d-flex align-items-center mb-2">
                                    <p class="starability-result m-0" data-rating="<%= review.rating %>">
                                        評価：<%= review.rating %>
                                    </p>
                                </div>

                                <p class="fw-bold mb-0 mt-2"><%= review.title %></p>
                                <p class="text-secondary review-body mb-0 mt-2"><%= review.body %></p>
                            </div>

                            <%# レビューの削除ボタン %>
                            <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                            <form action="/products/<%= product._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="flex-shrink-0 ms-3">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> 削除
                                </button>
                            </form>
                            <% } %>
                        </div>
                    <% } %>
                    
                    <% if (product.reviews.length === 0) { %>
                        <p class="text-muted">まだレビューがありません。</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%# 削除ボタン押下時の確認モーダル %>
<%- include('../partials/deleteModal') %>
<script src="/javascripts/target-delete.js"></script>