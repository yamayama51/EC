
<%# エラー画面 %>

<% layout('layouts/boilerplate') %>

<div class="row">
    <div class="offset-3 col-6">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading"><%= err.message || '問題が発生しました。' %></h4>
            <% if (!err.stack) { %>
                <p class="mb-0">
                    ご迷惑をおかけして申し訳ありません。時間をおいて再度お試しいただくか、ホーム画面へお戻りください。
                </p>
            <% } else { %>
                <p><%= err.stack %></p>
            <% } %>
        </div>
    </div>
</div>