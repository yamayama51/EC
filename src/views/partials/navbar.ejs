
<%# ナビゲーションバー %>

<nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top border-bottom faze-navbar">
  <div class="container-fluid">

    <a class="navbar-brand fw-bold py-3" href="/">FAZE.</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
      <span class="fw-bold faze-toggler">MENU</span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href="/">HOME</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/products">ALL ITEM</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="/products" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            CATEGORY
          </a>
          <ul class="dropdown-menu">
            <% Object.values(categories).forEach(category => { %>
              <li><a class="dropdown-item" href="/products?category=<%= category.name %>">
                <%= category.name %>
              </a></li>
            <% }) %>
          </ul>
        </li>
      </ul>
      <ul class="navbar-nav ms-auto">
        <%# ログインしていない場合 %>
        <% if (!currentUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/login">LOGIN</a>
        </li>
        <% } else { %>
          <%# 管理者の場合 %>
          <% if (currentUser.isAdmin) { %>
            <li class="nav-item">
              <a class="nav-link fw-bold text-success" href="/admin/dashboard">DASHBOARD</a>
            </li>    
          <%# 非管理者の場合 %>
          <% } %>
          <li class="nav-item">
          <a class="nav-link" href="/cart">CART</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/orders">ORDERS</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">LOGOUT</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>