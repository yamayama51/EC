
<%# 削除ボタン押下時の確認モーダル %>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        
            <div class="modal-body p-4 text-center">
                <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>
                
                <h5 class="fw-bold text-dark mb-3" id="deleteModalLabel">商品を削除しますか？</h5>

                <h6 class="fw-bold text-dark mb-3">
                    対象データ : <span id="targetName"></span>
                </h6>
                
                <p class="text-muted small mb-0">この操作は取り消せません。<br>本当に削除してもよろしいですか？</p>
            </div>
            
            <div class="modal-footer border-0 p-3 pt-0 d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary fw-bold flex-grow-1 py-1 px-3 small rounded-3" data-bs-dismiss="modal">
                    閉じる
                </button>
                
                <form action="" id="deleteForm" method="post" class="flex-grow-1 m-0">
                    <button type="submit" class="btn btn-danger fw-bold w-100 py-1 px-3 small rounded-3" data-original-text="削除する">
                        削除する
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>