
<%# カート編集画面 %>

<% layout('layouts/boilerplate') %>

<div class="faze-card">

    <%# ページタイトル %>
    <div class="faze-page-title">
        <h2>ショッピングカート</h2>
    </div>

    <div class="row g-lg-5">
        
        <%# カート内アイテム一覧 %>
        <div class="col-lg-8 mb-3">
        <% if (cart.items.length > 0) { %>
            <% cart.items.forEach(item => { %>
                <%# アイテム1個分 %>
                <div class="d-flex align-items-center py-4 border-bottom">

                    <%# 画像部分 %>
                    <a href="/products/<%= item.productId._id %>" class="text-decoration-none">
                        <div class="ratio ratio-1x1 bg-white rounded-3 shadow-sm overflow-hidden img-thumbnail">
                            <% if (item.productId.images.length > 0) { %>
                                <img src="<%= item.productId.images[0].thumbnail %>" class="object-fit-cover" alt="product-img">
                            <% } else { %>
                                <img src="/images/no-image.png" class="object-fit-cover" alt="no-img">
                            <% } %>
                        </div>
                    </a>

                    <%# アイテム詳細 %>
                    <div class="flex-grow-1 ms-3 ms-md-4">
                        <p><a href="/products/<%= item.productId._id %>" class="h6 text-decoration-none"><%= item.productId.name %></a></p>
                        <p class="fw-light">\ <%= item.productId.price.toLocaleString() %></p>
                    </div>

                    <%# カート操作 %>
                    <div class="text-end d-flex flex-column align-items-end">
                        <ul class="pagination pagination-sm">
                            <% if (item.quantity !== 1) { %>
                                <li class="page-item">
                                    <form action="/cart/<%= item.productId._id %>/reduce?_method=PATCH" method="POST">
                                        <button class="page-link text-dark">-</button>
                                    </form>
                                </li>
                            <% } %>
                            <li class="page-item disabled"><p class="page-link"><%= item.quantity %></p></li>
                            <% if (item.quantity < 10) { %>
                                <li class="page-item">
                                    <form action="/cart/<%= item.productId._id %>/add?_method=PATCH" method="POST">
                                        <button class="page-link text-dark">+</button>
                                    </form>
                                </li>
                            <% } %>
                        </ul>
                        <form action="/cart/<%= item.productId._id %>/delete?_method=PATCH" method="POST">
                            <button class="btn btn-link btn-sm text-muted text-decoration-none p-0 small">削除</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p class="h4 text-muted fw-bold">現在カートに商品がありません</p>
        <% } %>
        </div>

        <%# 注文内容・注文操作 %>
        <div class="col-lg-4">
            <div class="card bg-light shadow-sm rounded-3 p-4 border-0">
                <% if (cart.items.length > 0) { %>
                    <h2 class="h5 fw-bold text-dark mb-3">注文内容</h2>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-secondary small">商品合計</span>
                        <span class="fw-bold text-dark small">\ <%= total.toLocaleString() %></span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-secondary small">送料</span>
                        <span class="text-success small fw-bold">無料</span>
                    </div>

                    <hr class="my-4 opacity-10">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-dark fw-bold">合計金額</span>
                        <span class="h4 text-dark fw-bold">\ <%= total.toLocaleString() %></span>
                    </div>

                    <form action="/orders" method="post">
                        <div class="d-grid gap-2">
                            <% if (hasSoldOut) { %>
                                <button class="btn btn-dark btn-lg py-3 fw-bold shadow-sm disabled">売り切れの商品が含まれています</button>
                            <% } else { %>
                                <button type="submit" class="btn btn-dark btn-lg py-3 fw-bold shadow-sm">注文する</button>
                            <% } %>
                        </div>
                    </form>
                <% } else { %>
                    <a href="/products" class="btn btn-dark py-3">買い物を続ける</a>
                <% } %>
            </div>
        </div>
    </div>
</div>