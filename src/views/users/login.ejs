
<%# ログイン画面 %>

<% layout('layouts/boilerplate') %>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 faze-card">
        
        <h1 class="h3 fw-bold mb-2 text-dark text-center">ログイン</h1>
        <p class="text-secondary small text-center mb-4">アカウント情報を入力してください</p>

        <form action="/login" method="post" class="validated-form mb-5" novalidate>

            <div class="form-floating mb-4">
                <input type="text" name="email" class="form-control rounded-3" id="floatingEmail" placeholder="Email" required value="a@aa.com">
                <label for="floatingEmail" class="text-muted small">メールアドレス</label>
            </div>

            <div class="form-floating mb-4">
                <input type="password" name="password" class="form-control rounded-3" id="floatingPassword" placeholder="Password" required value="aaaaaaaa">
                <label for="floatingPassword" class="text-muted small">パスワード</label>
            </div>

            <div class="d-grid gap-3 mb-4">
                <button type="submit" class="btn btn-dark btn-lg py-3 fw-bold shadow-sm small">
                    ログインする
                </button>
            </div>

            <div class="text-center">
                <p class="small text-muted mb-1">アカウントをお持ちでないですか？</p>
                <a href="/register" class="text-decoration-none text-dark fw-bold small">新規アカウント登録</a>
            </div>
        </form>
    </div>
</div>