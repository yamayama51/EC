
<%# 注文履歴画面 %>

<% layout('layouts/boilerplate') %>

<div class="faze-container">

    <%# ページタイトル %>
    <div class="faze-page-title">
        <h2>注文履歴</h2>
    </div>

    <div class="mb-3">
        <%# 注文履歴がない場合 %>
        <% if (orders.length === 0) { %>
            <div class="d-flex justify-content-between align-items-center">
                <p class="h4 text-muted fw-bold mb-5">注文履歴がありません</p>
                <a href="/products" class="btn btn-dark px-5 py-3">買い物を続ける</a>
            </div>
        <% } %>
            
        <%# 注文履歴がある場合 %>
        <% for (order of orders) { %>
            <div class="faze-card p-3 mb-5 shadow-sm rounded-3">

                <%# 注文ステータスと合計金額 %>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <%# 注文ステータス %>
                    <div>
                        <p class="small text-muted mb-1">注文ステータス</p>
                        <span class="badge <%= getStatusBadge(order.status) %>">
                            <%= order.status.toUpperCase() %>
                        </span>
                    </div>
                    <%# 合計金額 %>
                    <div>
                        <p class="small text-muted mb-1">合計金額</p>
                        <p class="h5 fw-bold">&yen; <%= order.totalPrice.toLocaleString() %></p>
                    </div>
                </div>

                <%# 注文アイテム一覧 %>
                <div class="list-group list-group-flush mb-3">
                    <% for (item of order.items) { %>
                        <% if (item.variantId) { %>
                            
                            <div class="list-group-item d-flex align-items-center justify-content-between py-3 px-3 bg-transparent">
                                <div class="d-flex align-items-center">
                                    <a href="/products/<%= item.variantId.product._id %>" class="me-3">
                                        <div class="ratio ratio-1x1 bg-white rounded-3 shadow-sm overflow-hidden img-thumbnail">
                                            <% if (item.variantId.product.images.length > 0) { %>
                                                <img src="<%= item.variantId.product.images[0].url %>" class="object-fit-cover" alt="product-img">
                                            <% } else { %>
                                                <img src="/images/no-image.png" class="object-fit-cover" alt="no-img">
                                            <% } %>
                                        </div>
                                    </a>
                                    <div>
                                        <a href="/products/<%= item.variantId.product._id %>" class="h6 text-decoration-none">
                                            <%= item.variantId.product.name %>
                                        </a>
                                        <p class="text-muted faze-small mb-0">サイズ: <%= item.variantId.size.toUpperCase() %></p>
                                        <p>
                                            <span class="h6 text-dark">&yen; <%= item.priceAtPurchase.toLocaleString() %></span>
                                            <span class="text-muted faze-small"> 税込み /  数量: <%= item.quantity %></span>
                                        </p>
                                    </div>
                                </div>
                                <div>
                                    
                                </div>
                            </div>

                        <%# アイテムが削除されている場合の表示 %>
                        <% } else { %>
                            <div class="list-group-item d-flex align-items-center justify-content-between py-3 px-3 bg-transparent">
                                <div class="d-flex align-items-center">
                                    <div class="ratio ratio-1x1 bg-white rounded-3 shadow-sm overflow-hidden me-3 img-thumbnail">
                                        <img src="/images/no-image.png" class="object-fit-cover" alt="no-img">
                                    </div>
                                    <div>
                                        <p class="text-decoration-none text-dark mb-1">
                                            <%= item.productName %>
                                        </p>
                                        <p>
                                            <span class="h6 text-dark">&yen; <%= item.priceAtPurchase.toLocaleString() %></span>
                                            <span class="text-muted faze-small"> 税込み / 数量: <%= item.quantity %> (※現在は販売を終了しています)</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <%# 注文日と注文ID %>
                <div>
                    <p class="small fw-bold"><span class="text-muted">注文日 : </span><%= format(order.createdAt, 'yyyy年MM月dd日') %></p>
                </div>
                <div>
                    <p class="small fw-bold"><span class="text-muted">注文ID : </span><%= order.orderNumber %></p>
                </div>

                <%# 詳細ボタン %>
                <div class="d-grid gap-2">
                    <a href="/orders/<%= order._id %>" class="btn btn-outline-secondary py-2 mb-3">
                        注文詳細を見る
                    </a>
                </div>

            </div>
        <% } %>
    </div>
</div>