
<%# バリエーション編集画面 %>

<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div>
                        <h2 class="h4 mb-4">バリエーション編集</h2>
                        <h4 class="text-muted mb-4 h5">対象商品： <%= product.name %></h4>
                    </div>
                    <form action="/admin/products/<%= id %>/variants/<%= variant._id %>?_method=PUT" method="POST">
                        <div class="mb-5">
                            <label for="size">サイズ</label>
                            <select name="variant[size]" id="size" class="form-select" required>
                                <% sizes.forEach(size => { %>
                                    <option value="<%= size %>" <%= variant.size === size ? 'selected' : '' %>>
                                        <%= size.toUpperCase() %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/admin/products/<%= id %>/variants" class="text-muted text-decoration-none small">一覧へ戻る</a>
                            <button type="submit" class="btn btn-success px-4" data-original-text="更新">更新</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>