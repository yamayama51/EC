
<%# オーダー管理画面 %>

<% layout('layouts/boilerplate') %>

<div class="d-flex justify-content-between align-items-center mb-5">
    <h2>注文管理</h2>
</div>

<div class="container mt-4">
    <% if (orders.length === 0) { %>
        <div class="col-md-6">
            <p class="h4 text-muted fw-bold mb-5">まだ注文はありません。</p>
        </div>
    <% } else { %>
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>注文ID</th>
                        <th>注文日時</th>
                        <th>支払期限</th>
                        <th>連絡先 (E-mail)</th>
                        <th>ステータス</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let order of orders) { %>
                        <tr class="<%= order.status === 'cancelled' ? 'text-decoration-line-through text-muted' : '' %>">
                            <%# 注文ID %>
                            <td>
                                <div class="my-3">
                                    <a href="/orders/<%= order._id %>" class="fw-bold text-decoration-none 
                                        <%= order.status === 'cancelled' ? 'text-decoration-line-through text-muted' : '' %>">
                                        <%= order._id %>
                                    </a>
                                </div>
                            </td>

                            <%# 注文日時 %>
                            <td>
                                <%= format(order.createdAt, 'yyyy/MM/dd HH:mm') %>
                            </td>

                            <%# 支払期限 %>
                            <td class="<%= (new Date() > order.paymentDeadline && order.status === 'pending') ? 'text-danger fw-bold' : '' %>">
                                <%= format(order.paymentDeadline, 'yyyy/MM/dd HH:mm') %>
                            </td>

                            <%# 注文者メールアドレス %>
                            <td><%= order.user.email %></td>

                            <%# 注文ステータス %>
                            <td colspan="2">
                                <form action="/admin/orders/<%= order._id %>/update-status?_method=PUT" method="POST" class="d-flex align-items-center">
                                    <select name="status" class="form-select form-select-sm me-3 w-auto">
                                        <% Object.values(ORDER_STATUS).forEach(status => { %>
                                            <option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>>
                                                <%= status.toUpperCase() %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-success">更新</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
    <% } %>
</div>