
<%# カテゴリー編集画面 %>

<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="h4 mb-4">カテゴリー名編集</h2>
                    <form action="/admin/categories/<%= category._id %>?_method=PUT" method="POST">
                        <div class="mb-3">
                            <label class="form-label text-muted">カテゴリー名</label>
                            <input type="text" name="category[name]" class="form-control" value="<%= category.name %>" required>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/admin/categories" class="text-muted text-decoration-none small">一覧へ戻る</a>
                            <button class="btn btn-success px-4">更新</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>